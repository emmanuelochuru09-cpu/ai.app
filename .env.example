# GEMINI_API_KEY: Required for Gemini AI API calls (Ad Generator, Social Media, AI Assistant, Website Drafts).
# In Google AI Studio, this is automatically configured from the Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for public website publishing links and webhooks.
APP_URL="http://localhost:3000"

# PAYSTACK_PUBLIC_KEY: Public key for Paystack payment gateway (Nigeria / Africa / Global)
PAYSTACK_PUBLIC_KEY="pk_test_sample_key"

# PAYSTACK_SECRET_KEY: Optional secret key for live server payment verification (optional in sandbox)
PAYSTACK_SECRET_KEY="sk_test_sample_key"

# FLUTTERWAVE_PUBLIC_KEY: Optional public key for Flutterwave payments
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-sample_key"

# PORT: Server listening port (default 3000)
PORT=3000
